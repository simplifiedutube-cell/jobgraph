# Copy to .env and edit. There is no API key here by design — all inference
# runs through the `claude` CLI on your existing Claude Code session.

# ---- safety -----------------------------------------------------------------
# Fill and screenshot ATS forms but never click submit. Flip to false only
# after you have watched at least one live submission succeed.
DRY_RUN=true

# Below this fit score the graph stops before generating anything.
MIN_FIT_SCORE=75

MAX_SUBMISSIONS_PER_RUN=5
DAILY_SUBMISSION_CAP=15

# auto | first_n | always  — first_n pauses before the first N submissions.
REVIEW_MODE=auto
REVIEW_FIRST_N=3

MAX_REVISIONS=2
MIN_KEYWORD_COVERAGE=70

# ---- engine -----------------------------------------------------------------
# Concurrent `claude` subprocesses. Each one is a real process; 4 is plenty.
LLM_CONCURRENCY=4
LLM_TIMEOUT_S=300
LLM_MAX_ATTEMPTS=3
LLM_CLI_RETRIES=3

# Per-node routing. fast=haiku/low, standard=sonnet/medium, deep=opus/high.
# Keep the number of DISTINCT profiles small — each one maintains its own
# ~19k-token warm prefix and pays a cache write the first time it is used.
PROFILE_PLAN_SEARCHES=fast
PROFILE_PARSE_JD=fast
PROFILE_SCORE_FIT=standard
PROFILE_TAILOR=standard
PROFILE_COVER_LETTER=standard
PROFILE_SCREENING=standard
PROFILE_CRITIQUE=standard

# ---- browser ----------------------------------------------------------------
# Logged-in boards detect headless far more often. Leave this false.
HEADLESS=false

# Attach to a Chrome you started yourself with --remote-debugging-port=9222,
# reusing sessions you are already logged into. Leave unset to use the
# project's own browser profile in data/browser/.
# CHROME_CDP_URL=http://localhost:9222
